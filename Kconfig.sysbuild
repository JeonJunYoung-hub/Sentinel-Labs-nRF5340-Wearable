# The nRF5340 BLE controller lives on the network core. Sysbuild builds the
# ipc_radio image for it and merges the hex - without this the app core comes
# up but bt_enable() fails.

source "${ZEPHYR_BASE}/share/sysbuild/Kconfig"

config NRF_DEFAULT_IPC_RADIO
	default y

config NETCORE_IPC_RADIO_BT_HCI_IPC
	default y
